'.source.magma':
  editor:
    commentStart: '// '
    commentDelimiters:
      line: '//'
      block: ['/*', '*/']
    # Used only by the TextMate grammar; the Tree-sitter grammar indents with
    # grammars/tree-sitter/indents.scm.
    increaseIndentPattern: '^\\s*(function|procedure|intrinsic|if|for|while|elif|else|case|when|repeat|try|catch)\\b[^;]*$|^\\s*\\b([A-Za-z_][A-Za-z0-9_]*)\\b\\s*:=\\s*\\b(function|procedure)\\b.*$'
    decreaseIndentPattern: '^\\s*((end\\s+(for|if|procedure|function|intrinsic|case|while|try))|else|elif|until|catch|when)\\b.*'
